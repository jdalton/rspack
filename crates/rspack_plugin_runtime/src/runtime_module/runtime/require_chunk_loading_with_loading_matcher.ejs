// require() chunk loading for javascript
<%- ENSURE_CHUNK_HANDLERS %>.require = <%- basicFunction("chunkId, promises") %> {
	// "1" is the signal for "already loaded"
	if (!<%- _installed_chunks %>[chunkId]) {
		if (<%- _js_matcher %>) {
			<%- _install_chunk %>(require("<%- _output_dir %>" + <%- GET_CHUNK_SCRIPT_FILENAME %>(chunkId)));
		} else <%- _installed_chunks %>[chunkId] = 1;
	}
};
